# Aponta pro config.php real fora do document root (sobrevive a um clone
# limpo do Git Deploy, que apaga tudo que não está versionado dentro de
# public_html). Ver lib/config.php.
<IfModule mod_env.c>
    SetEnv MVCUFPR_CONFIG_PATH /home/u262251177/config-ufpr.php
</IfModule>

# Garante que o header Authorization chegue ao PHP em alguns hosts compartilhados.
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Todo pedido dentro de /api vai pro front controller, exceto se for um
# arquivo real (ex.: uploads servidas por outro caminho no futuro).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

# Bloqueia acesso direto a config.php e à pasta lib/.
<Files "config.php">
    Require all denied
</Files>
<Files "config.example.php">
    Require all denied
</Files>

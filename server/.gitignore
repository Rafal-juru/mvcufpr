node_modules/
.env
.env.local
*.log
.DS_Store

# Imagens enviadas em runtime — não versionar (manter só a pasta via .gitkeep)
uploads/*
!uploads/.gitkeep

# OBS: server/public (build do Vite) É versionado de propósito, porque o host
# roda apenas Node 17 e não consegue buildar — o build é feito localmente com
# `npm run build:deploy` e enviado junto pelo Git deploy do Plesk.
